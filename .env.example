# 监听地址：开发可用 127.0.0.1；局域网直连可设 0.0.0.0
# 经 Nginx 反代的生产环境必须使用 127.0.0.1，避免绕过反向代理
HOST=127.0.0.1
PORT=8090

# 开发热重载；生产环境必须为 false
DEBUG=true

# 时区
TZ=Asia/Shanghai

# 可选：自定义数据文件路径（相对项目根或绝对路径）
# DATA_FILE=data/navigation.yml

# 访问密钥：留空则完全不鉴权（所有人可编辑，兼容旧行为）。
# 设置后：未登录/密钥错误的访客为只读模式；手机端始终为只读访客。
# KEY=change-me
